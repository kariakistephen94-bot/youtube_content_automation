# Copy to .env and fill in. Never commit .env.

# --- AI provider: "openai" (default) or "gemini" ---
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Narration voice provider: openai-tts (default), gemini-tts, or macos-say (local, free)
TTS_PROVIDER=openai-tts
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# --- Gemini (only when AI_PROVIDER=gemini) ---
GEMINI_API_KEY=
# Any Gemini model that supports JSON-schema structured output.
GEMINI_MODEL=gemini-3.6-flash

# --- GitHub (for "Connect with GitHub" in the web UI) ---
# Client ID of your GitHub OAuth App with "Enable Device Flow" ticked (not a secret). See README.
GITHUB_CLIENT_ID=

# --- Optional overrides (defaults shown) ---
# TUTORIAL_AI_OUTPUT_DIRECTORY=output
# TUTORIAL_AI_WORKSPACE_DIRECTORY=~/.tutorial-ai/workspace   # outside the repo: tutorials run `uv init` here
# TUTORIAL_AI_MAX_CONTEXT_TOKENS=120000     # budget for repository content sent to the AI
# TUTORIAL_AI_MAX_FILE_BYTES=200000         # larger files are listed but never sent
# TUTORIAL_AI_MAX_CHARS_PER_FILE=40000      # per-file truncation inside the prompt
# TUTORIAL_AI_AI_TEMPERATURE=0.3
# TUTORIAL_AI_AI_MAX_OUTPUT_TOKENS=32768
# TUTORIAL_AI_AI_MAX_VALIDATION_RETRIES=2
# TUTORIAL_AI_LOG_LEVEL=INFO

# Set to true only for a Vertex AI key (needs the Vertex AI API enabled on its GCP project).
# GOOGLE_GENAI_USE_VERTEXAI=false
